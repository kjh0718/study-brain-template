filters:
  or:
    - file.inFolder("study")
    - file.inFolder("wiki")
properties:
  file.name:
    displayName: 노트
  note.title:
    displayName: 제목
  file.folder:
    displayName: 폴더
  note.status:
    displayName: 상태
  note.course:
    displayName: 과목
  note.topics:
    displayName: 주제
  note.updated:
    displayName: 수정일
  note.date:
    displayName: 수업일
  note.aliases:
    displayName: 다른 표기
  note.resource_type:
    displayName: 자료 종류
  note.authority:
    displayName: 권위
  note.provenance:
    displayName: 입수 경로
  note.year:
    displayName: 연도
  note.exam_type:
    displayName: 시험 종류
views:
  - type: table
    name: 강의
    filters:
      and:
        - note.type == "lecture"
    groupBy:
      property: course
      direction: ASC
    order:
      - file.name
      - title
      - date
      - status
      - topics
      - file.folder
  - type: table
    name: 개념
    filters:
      and:
        - note.type == "concept"
    order:
      - file.name
      - title
      - status
      - topics
      - aliases
      - updated
  - type: table
    name: 자료
    filters:
      and:
        - note.type == "resource"
    order:
      - file.name
      - title
      - resource_type
      - authority
      - status
      - course
      - file.folder
  - type: table
    name: 기출
    filters:
      and:
        - note.type == "past-exam"
    order:
      - file.name
      - title
      - year
      - exam_type
      - authority
      - provenance
      - status
      - file.folder
