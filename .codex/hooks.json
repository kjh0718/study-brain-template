{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/_system/hooks/session_context.py\"",
            "commandWindows": "powershell.exe -NoProfile -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
